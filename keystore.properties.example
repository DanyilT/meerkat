# Release signing. Copy this file to keystore.properties and fill it in.
# keystore.properties and the keystore itself are ignored by git. Never commit either.
#
# Create a keystore once and keep it safe, with a backup. If it is lost, updates can no longer be
# published under the same app identity:
#   keytool -genkeypair -v -keystore meerkat-release.jks -alias meerkat \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is relative to the project root, or an absolute path.
storeFile=meerkat-release.jks
storePassword=
keyAlias=meerkat
keyPassword=
